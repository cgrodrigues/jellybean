# Copy to `.env` and fill in. Never commit the real `.env`.

# --- LLM provider -----------------------------------------------------------
# One of: anthropic | openai | bedrock
JELLYBEAN_PROVIDER=anthropic
# Model identifier as expected by the chosen provider (no default in code).
JELLYBEAN_MODEL=
# API key for anthropic / openai. Not used by bedrock (see AWS settings below).
JELLYBEAN_API_KEY=

# --- AWS Bedrock (only when JELLYBEAN_PROVIDER=bedrock) ---------------------
# Standard AWS credential chain is used (profile, env vars, SSO, instance role).
# AWS_REGION=eu-west-1
# AWS_PROFILE=default
# AWS_BEARER_TOKEN_BEDROCK=   # Bedrock API key, alternative to IAM credentials

# --- Paths ------------------------------------------------------------------
# Root folder of the input Parquet datasets (read-only for the agents).
JELLYBEAN_DATA_ROOT=./data
# Root folder where run workspaces and the pattern registry are written.
JELLYBEAN_WORKSPACE_ROOT=./workspace
# Ground truth of the dummy data. Agents can never read it; it is only listed
# here so that `run_sql` can explicitly refuse it.
JELLYBEAN_GROUND_TRUTH_ROOT=./ground_truth
# Location of the thresholds/limits file.
JELLYBEAN_CONFIG_FILE=./config.yaml
